{
  "name": "ozon-gmv-dashboard",
  "version": "1.5.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web,notifier -c blue,cyan,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:notifications\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:notifications": "tsx watch scripts/dev-notification-agent.ts",
    "dev:workspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-workspace-dev.ps1",
    "dev:demo": "vite --mode demo",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup src/server/index.ts src/server/maintenance.ts src/server/notification-agent.ts --format esm --platform node --target node24 --out-dir dist/server --sourcemap",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:import-postgres": "tsx scripts/migrate-postgres-to-sqlite.ts",
    "password:hash": "tsx scripts/hash-password.ts",
    "service:mac:install": "bash installer/macos/manage-service.sh install",
    "service:mac:status": "bash installer/macos/manage-service.sh status",
    "service:mac:restart": "bash installer/macos/manage-service.sh restart",
    "service:mac:update": "bash installer/macos/manage-service.sh update",
    "service:mac:uninstall": "bash installer/macos/manage-service.sh uninstall",
    "package:windows": "powershell -ExecutionPolicy Bypass -File installer/windows/build-installer.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@tanstack/react-query": "^5.85.5",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "lucide-react": "^0.539.0",
    "node-notifier": "^10.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "sharp": "0.35.3",
    "undici": "^7.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/node-notifier": "^8.0.5",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
