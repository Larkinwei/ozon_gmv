{
  "name": "ozon-category-snapshot-service",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/configure-lifecycle.ts --format esm --platform node --target node20 --out-dir dist",
    "start": "node dist/server.js",
