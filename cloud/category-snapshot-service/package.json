    "test": "vitest run",
    "oss:lifecycle": "node dist/configure-lifecycle.js"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
